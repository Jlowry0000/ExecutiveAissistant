{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567891",
  "name": "01 - Email Triage Pipeline",
  "nodes": [
    {
      "id": "schedule-1",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "interval": 5
            }
          ]
        }
      },
      "name": "IMAP Scheduler",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 300]
    },
    {
      "id": "read-email-1",
      "parameters": {
        "brand": "gmail",
        "credentials": {
          "imap": {
            "id": "imap-gmail-cred",
            "name": "Gmail IMAP"
          }
        },
        "action": "read",
        "block": false,
        "format": "resolved",
        "emailProperties": ["body", "sender", "subject", "headers", "messageId"]
      },
      "name": "Read Gmail Emails",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 1.3,
      "position": [300, 300],
      "credentials": {
        "imap": {
          "id": "imap-gmail-cred",
          "name": "Gmail IMAP"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "fetch-context-1",
      "parameters": {
        "url": "http://api:8000/context",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "X-N8N-Key",
                "value": "{{ $env.N8N_API_KEY }}"
              }
            ]
          }
        }
      },
      "name": "Fetch BusinessContext",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "id": "normalize-1",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst context = items[0].json;\n\nconst normalized = items.map(item => {\n  const email = item.json;\n  return {\n    json: {\n      body: email.body || '',\n      sender: email.sender || email.from || '',\n      sender_name: email.senderName || email.fromName || '',\n      subject: email.subject || '',\n      message_id: email.messageId || email.id || '',\n      context: context\n    }\n  };\n});\n\n$output[0].push(...normalized);\n$output[1].push(...normalized);"
      },
      "name": "Normalize Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "id": "llm-triage-1",
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/llm/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Key",
              "value": "{{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "provider",
              "value": "openai"
            },
            {
              "name": "json_output",
              "value": true
            },
            {
              "name": "messages",
              "value": "=[{\"role\":\"system\",\"content\":\"You are an elite executive assistant AI. Analyze emails and return JSON: {is_flagged, flag_reason, summary, suggested_action, draft_response}\"},{\"role\":\"user\",\"content\":\"From: {{ $json.sender }}\\nSubject: {{ $json.subject }}\\n\\n{{ $json.body }}\\n\\nContext: {{ JSON.stringify($json.context) }}\"}]"
            },
            {
              "name": "temperature",
              "value": 0.2
            }
          ]
        },
        "options": {}
      },
      "name": "LLM Triage Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "id": "merge-1",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst emailData = items[1].json;\nlet triageResult = {is_flagged: false};\ntry {\n  const content = items[0].json.content;\n  const match = content?.match(/\\{[\\s\\S]*\\}/);\n  if (match) triageResult = JSON.parse(match[0]);\n} catch (e) {\n  console.error('Failed to parse LLM triage result:', e.message);\n}\n\nreturn [{\n  json: {\n    message_id: emailData.message_id,\n    sender: emailData.sender,\n    sender_name: emailData.sender_name,\n    subject: emailData.subject,\n    body: emailData.body,\n    body_preview: (emailData.body || '').substring(0, 200),\n    summary: triageResult.summary,\n    flag_reason: triageResult.flag_reason,\n    suggested_action: triageResult.suggested_action,\n    draft_response: triageResult.draft_response,\n    is_flagged: triageResult.is_flagged,\n    is_read: true\n  }\n}];"
      },
      "name": "Merge Email + Triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "id": "save-1",
      "parameters": {
        "url": "http://api:8000/correspondence/flagged",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {"name": "message_id", "value": "{{ $json.message_id }}"},
            {"name": "sender", "value": "{{ $json.sender }}"},
            {"name": "sender_name", "value": "{{ $json.sender_name }}"},
            {"name": "subject", "value": "{{ $json.subject }}"},
            {"name": "body", "value": "{{ $json.body }}"},
            {"name": "body_preview", "value": "{{ $json.body_preview }}"},
            {"name": "summary", "value": "{{ $json.summary }}"},
            {"name": "flag_reason", "value": "{{ $json.flag_reason }}"},
            {"name": "suggested_action", "value": "{{ $json.suggested_action }}"},
            {"name": "draft_response", "value": "{{ $json.draft_response }}"},
            {"name": "is_flagged", "value": "{{ $json.is_flagged }}"},
            {"name": "is_read", "value": "{{ $json.is_read }}"}
          ]
        },
        "options": {
          "headers": {
            "entries": [
              {"name": "X-N8N-Key", "value": "{{ $env.N8N_API_KEY }}"}
            ]
          }
        }
      },
      "name": "Save to NocoDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "IMAP Scheduler": {"main": [[{"node": "Read Gmail Emails", "type": "main", "index": 0}]]},
    "Read Gmail Emails": {"main": [[{"node": "Fetch BusinessContext", "type": "main", "index": 0}]]},
    "Fetch BusinessContext": {"main": [[{"node": "Normalize Email Data", "type": "main", "index": 0}]]},
    "Normalize Email Data": {
      "main": [
        [{"node": "LLM Triage Engine", "type": "main", "index": 0}],
        [{"node": "Merge Email + Triage", "type": "main", "index": 1}]
      ]
    },
    "LLM Triage Engine": {"main": [[{"node": "Merge Email + Triage", "type": "main", "index": 0}]]},
    "Merge Email + Triage": {"main": [[{"node": "Save to NocoDB", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "meta": {}
}