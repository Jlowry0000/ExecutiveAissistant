# =============================================================================
# AI Executive Assistant - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=exec_assistant
POSTGRES_USER=exec_assistant
POSTGRES_PASSWORD=change_me_generate_strong_password

# -----------------------------------------------------------------------------
# NocoDB
# -----------------------------------------------------------------------------
NOCODB_PORT=8080
NOCODB_JWT_SECRET=change_me_generate_strong_jwt_secret

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=change_me_strong_password
N8N_HOST=localhost
N8N_WEBHOOK_URL=https://your-domain.com/webhook
GENERIC_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# FastAPI Webhook Service
# -----------------------------------------------------------------------------
API_KEY=change_me_generate_strong_api_key

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# MiniMax
MINIMAX_API_KEY=...
MINIMAX_MODEL=abab6-chat

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# IMAP Email Accounts (Gmail default)
# -----------------------------------------------------------------------------
# Format: JSON array of account configs
# Example:
#   [{"name":"gmail","provider":"gmail","host":"imap.gmail.com","port":993,"username":"you@gmail.com","password":"app_password","is_active":true}]
IMAP_ACCOUNTS=[{"name":"gmail","provider":"gmail","host":"imap.gmail.com","port":993,"username":"","password":"","is_active":false}]

# Default LLM Provider (openai|ollama|minimax|deepseek)
DEFAULT_LLM_PROVIDER=openai