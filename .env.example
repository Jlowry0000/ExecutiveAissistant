# =============================================================================
# AI Executive Assistant - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=exec_assistant
POSTGRES_USER=exec_assistant
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# NocoDB
# -----------------------------------------------------------------------------
NOCODB_PORT=8080
NOCODB_JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
NOCODB_ADMIN_JWT_SECRET=REPLACE_WITH_SECURE_ADMIN_JWT_SECRET
NOCODB_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
N8N_HOST=localhost
N8N_WEBHOOK_URL=https://your-domain.com/webhook
GENERIC_TIMEZONE=America/New_York
N8N_API_KEY=REPLACE_WITH_SECURE_N8N_API_KEY
DIGEST_EMAIL_TO=you@example.com

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCRYPTION_KEY

# -----------------------------------------------------------------------------
# FastAPI Webhook Service
# -----------------------------------------------------------------------------
# API_KEY: used for external calls to the API
# N8N_API_KEY: used by n8n workflows to call the API (must match N8N_API_KEY above)
API_KEY=REPLACE_WITH_SECURE_API_KEY

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# MiniMax
MINIMAX_API_KEY=...
MINIMAX_MODEL=abab6-chat

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Default LLM Provider (openai|ollama|minimax|deepseek)
DEFAULT_LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Data Retention
# -----------------------------------------------------------------------------
# Number of days to keep flagged emails, digests, and action items before cleanup
DATA_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Reverse Proxy (nginx)
# -----------------------------------------------------------------------------
NGINX_SERVER_NAME=localhost
# For future Let's Encrypt setup:
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem